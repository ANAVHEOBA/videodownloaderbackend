# Server
APP_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
RUST_LOG=info,tower_http=info

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/videodownloaderbackend
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
DATABASE_RUN_MIGRATIONS=true

# Frontend / CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Download API
DOWNLOAD_TOKEN_SECRET=replace-this-with-a-long-random-secret
DOWNLOAD_TOKEN_TTL_SECONDS=300
MAX_URL_LENGTH=2048
MAX_DOWNLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=1800

# Upstream fetching
UPSTREAM_CONNECT_TIMEOUT_SECONDS=10
UPSTREAM_REQUEST_TIMEOUT_SECONDS=60
UPSTREAM_MAX_REDIRECTS=10
UPSTREAM_USER_AGENT=videodownloaderbackend/0.1
STREAM_CHUNK_SIZE_BYTES=65536

# Extraction / download runtime
YTDLP_BINARY_PATH=yt-dlp
YTDLP_METADATA_TIMEOUT_SECONDS=20
YTDLP_DOWNLOAD_TIMEOUT_SECONDS=600
DOWNLOAD_RETENTION_SECONDS=600

# Rate limiting / abuse protection
RATE_LIMIT_REQUESTS_PER_MINUTE=30
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Provider toggles
ENABLE_TIKTOK=true
ENABLE_INSTAGRAM=true
ENABLE_YOUTUBE=true
ENABLE_TWITTER=true
ENABLE_FACEBOOK=true
ENABLE_PINTEREST=true
ENABLE_CAPCUT=true
ENABLE_TELEGRAM=true
ENABLE_SPOTIFY=true
ENABLE_SOUNDCLOUD=true

# Optional authenticated scraping
COOKIES_FILE_PATH=
# Railway-friendly alternative: base64 of a Netscape cookies.txt file.
COOKIES_FILE_CONTENT_BASE64=

# Provider fallbacks
TIKTOK_FALLBACK_ENABLED=true
TIKTOK_FALLBACK_API_URL=https://tikwm.com/api/
INSTAGRAM_OEMBED_FALLBACK_ENABLED=true

# Optional media processing
FFMPEG_ENABLED=true
FFMPEG_BINARY_PATH=ffmpeg

# Runtime storage
TEMP_DIR=/tmp/videodownloaderbackend
